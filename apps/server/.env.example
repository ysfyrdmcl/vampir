NODE_ENV=development
PORT=3000

CORS_ORIGIN=*
SOCKET_PATH=/socket.io
CLIENT_LOGS_ENABLED=false
SOCKET_RATE_LIMIT_WINDOW_MS=10000
SOCKET_RATE_LIMIT_MAX_EVENTS=80
# Shared-address limit survives reconnects; allow multiple players on one Wi-Fi.
SOCKET_IP_MAX_EVENTS=800
SOCKET_MAX_CONNECTIONS=1000
SOCKET_MAX_CONNECTIONS_PER_IP=100
ROOM_MAX_COUNT=200

ROOM_CODE_LENGTH=6
ROOM_MIN_PLAYERS=4
ROOM_MAX_PLAYERS=20
ROOM_IDLE_TTL_SECONDS=1800
ROOM_AFTER_GAME_TTL_SECONDS=300

ROLE_REVEAL_SECONDS=10
NIGHT_INTRO_SECONDS=5
VAMPIRE_ACTION_SECONDS=30
DETECTIVE_ACTION_SECONDS=20
DOCTOR_ACTION_SECONDS=20
DAY_DISCUSSION_SECONDS=120
DAY_VOTE_SECONDS=45
RESULT_SCREEN_SECONDS=10

# Master switch. false ise LLM, embedding ve uzak API baglantilari tamamen kapali kalir.
BOT_AI_ENABLED=false
BOT_LLM_ENABLED=false
BOT_LLM_PROVIDER=openai
BOT_LLM_MODEL=gpt-5-mini
BOT_LLM_TIMEOUT_MS=6000
BOT_LLM_MAX_CALLS_PER_PHASE=3
BOT_LLM_TARGET_RANKING_ENABLED=false
BOT_INTERACTION_MAX_CHAIN_LENGTH=2
BOT_EMBEDDING_ENABLED=false
BOT_EMBEDDING_MODEL=text-embedding-ada-002
# Optional, supported by text-embedding-3 models.
# BOT_EMBEDDING_DIMENSIONS=1536
# Keep this server-side only. Never expose it to the mobile app.
# OPENAI_API_KEY=sk-...
