# Preview APK/IPA: use your laptop's LAN IP on the same Wi-Fi, or an HTTPS test server.
# Production: HTTPS/WSS required. Never use localhost for a physical phone.
EXPO_PUBLIC_SOCKET_URL=http://192.168.1.100:3000
EXPO_PUBLIC_SOCKET_PATH=/socket.io
# Set in the EAS build environment before production builds:
# EAS_PROJECT_ID=your-eas-project-uuid
# IOS_BUNDLE_IDENTIFIER=com.vampirkoylu.game
# ANDROID_PACKAGE=com.vampirkoylu.game
